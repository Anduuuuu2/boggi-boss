{
  "$schema": "boggi-tokens/v0.1",
  "$status": "Propuesta BB-020. Fuente de verdad para packages/ui/src/tokens.ts cuando exista el scaffold.",
  "color": {
    "ink": "#1C1B22",
    "inkSoft": "#4F4A57",
    "paper": "#FFF8EF",
    "surface": "#FFFFFF",
    "surfaceMuted": "#F5ECE0",
    "line": "#E4D7C6",
    "focus": "#2F5BFF",
    "dangerText": "#A32014",
    "onInk": "#FFFFFF",
    "agent": {
      "boggi": { "base": "#FFB98A", "soft": "#FFE4D1", "deep": "#F2925A" },
      "timo": { "base": "#8EDDBE", "soft": "#DCF5EB", "deep": "#5CC49E" },
      "milo": { "base": "#FFD86B", "soft": "#FFF1C4", "deep": "#F2BE34" },
      "nilo": { "base": "#A8B5FF", "soft": "#E2E6FF", "deep": "#7F90F2" }
    },
    "status": {
      "pending": { "bg": "#ECE6DE", "fg": "#1C1B22", "icon": "clock" },
      "awaiting_approval": { "bg": "#FFDF9E", "fg": "#1C1B22", "icon": "hand" },
      "scheduled": { "bg": "#E2E6FF", "fg": "#1C1B22", "icon": "calendar" },
      "running": { "bg": "#CDEBFF", "fg": "#1C1B22", "icon": "spinner" },
      "completed": { "bg": "#C8EFD2", "fg": "#1C1B22", "icon": "check" },
      "failed": { "bg": "#FFCFC8", "fg": "#1C1B22", "icon": "alert" },
      "cancelled": { "bg": "#E9E4DE", "fg": "#4F4A57", "icon": "slash" }
    },
    "demo": { "bg": "#1C1B22", "fg": "#FFD86B" }
  },
  "space": { "0": 0, "1": 4, "2": 8, "3": 12, "4": 16, "5": 20, "6": 24, "8": 32, "10": 40, "12": 48, "16": 64 },
  "radius": { "sm": 8, "md": 14, "lg": 20, "xl": 28, "pill": 999 },
  "stroke": {
    "hairline": 1,
    "ui": 2,
    "uiStrong": 2.5,
    "illustration": { "sm": 2.5, "md": 4, "lg": 5 }
  },
  "shadow": {
    "ink": { "x": 0, "y": 3, "blur": 0, "color": "#1C1B22", "note": "Firma: sombra sólida desplazada. Desaparece al presionar." },
    "soft": { "x": 0, "y": 8, "blur": 24, "color": "rgba(28,27,34,0.10)", "androidElevation": 4 }
  },
  "font": {
    "display": { "family": "Nunito", "weights": [700, 800], "license": "OFL-1.1" },
    "text": { "family": "Inter", "weights": [400, 500, 600], "license": "OFL-1.1" },
    "fallback": "System"
  },
  "type": {
    "display": { "font": "display", "size": 32, "line": 38, "weight": 800 },
    "title1": { "font": "display", "size": 26, "line": 32, "weight": 800 },
    "title2": { "font": "display", "size": 21, "line": 28, "weight": 700 },
    "headline": { "font": "text", "size": 17, "line": 24, "weight": 600 },
    "body": { "font": "text", "size": 16, "line": 24, "weight": 400 },
    "callout": { "font": "text", "size": 15, "line": 22, "weight": 500 },
    "footnote": { "font": "text", "size": 13, "line": 18, "weight": 400 },
    "caption": { "font": "text", "size": 12, "line": 16, "weight": 500 }
  },
  "a11y": {
    "minTapTarget": 48,
    "maxFontScale": 1.6,
    "minContrastText": 4.5,
    "minContrastLargeTextAndIcons": 3
  },
  "motion": {
    "duration": { "fast": 120, "base": 200, "slow": 320 },
    "spring": { "damping": 18, "stiffness": 220, "mass": 1 },
    "reducedMotion": "Sin traslaciones/escala ni bucles; solo cambios de opacidad <= 120 ms o estado instantáneo."
  }
}
